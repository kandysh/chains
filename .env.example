# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
PROCESSOR_PORT=8001
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trade_recon

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=trade-recon
S3_UPLOAD_PREFIX=uploads
PRESIGNED_URL_EXPIRY=900        # seconds (15 min)

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

# ── Matching thresholds ───────────────────────────────────────────────────────
FUZZY_HIGH_CONFIDENCE=0.90     # auto-confirmed above this
FUZZY_AMBIGUOUS_MIN=0.70       # pending_review between this and high_confidence

# ── Redis Streams ─────────────────────────────────────────────────────────────
PROCESSING_STREAM=processing:queue
CONSUMER_GROUP=processor-group
CONSUMER_NAME=processor-1
STREAM_READ_COUNT=1
STREAM_BLOCK_MS=5000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
