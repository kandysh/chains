OPENAI_API_KEY=your_key_here
DATABASE_URL=sqlite:///./confirmations.db
API_HOST=0.0.0.0
API_PORT=8000
LARGE_TRADE_THRESHOLD=10000000
AUTO_PROCESS_CONFIDENCE_THRESHOLD=0.7

# Redis Configuration for Task Queuing
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Storage Configuration (local or s3)
STORAGE_TYPE=local
STORAGE_PATH=storage

# AWS/S3 Configuration (if using S3 storage)
S3_BUCKET_NAME=confirmations
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Job Configuration
JOB_TIMEOUT=10h
MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
